# Porta HTTP da API
PORT=3000

# Conexão PostgreSQL local. No Docker Compose, DB_HOST é substituído por "db".
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=med_desafio

# Em Docker, as migrations são aplicadas no boot da API. Localmente, prefira
# executar "npm run migration:run" de forma explícita.
RUN_MIGRATIONS_ON_START=false
